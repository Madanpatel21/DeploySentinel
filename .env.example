# DeploySentinel Environment Configuration Template
# Copy to .env and populate real credentials for your environment

NODE_ENV=development
PORT=4000
HOST=0.0.0.0
WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=/api/v1

# Supabase PostgreSQL Persistence (releaseguard schema)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_DB_SCHEMA=releaseguard

# Auth & Cryptographic Signing (use >=32 byte random hex secrets in production)
JWT_SECRET=replace-with-64-char-hex-secret
PASSPORT_SIGNING_SECRET=replace-with-64-char-hex-secret
WEBHOOK_SIGNING_SECRET=replace-with-64-char-hex-secret
ENCRYPTION_KEY=replace-with-64-char-hex-secret

# Optional Redis / BullMQ (falls back to durable DB queue when omitted)
REDIS_URL=

# Provider-Independent AI Adapter (local deterministic fallback requires zero paid keys)
AI_PROVIDER=local
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Optional External Connector Credentials
LINEAR_API_KEY=
VERCEL_TOKEN=
GITHUB_TOKEN=
SLACK_WEBHOOK_URL=
